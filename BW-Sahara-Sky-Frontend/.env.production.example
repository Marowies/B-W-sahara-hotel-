# Export these variables in the build environment; Node does not load this file automatically.
HOTEL_SITE_ORIGIN=https://bwsaharaskyhotel.com
HOTEL_INDEXABLE=1
HOTEL_BACKEND_MODE=same-origin
# The production web server must route /api/hotel and /admin to Laravel.
# tools/serve.mjs is a local preview server and must not be used for production.
