{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": false
  },
  "framework": null,
  "installCommand": "npm install",
  "buildCommand": "node tools/vercel-build.mjs",
  "outputDirectory": "dist",
  "routes": [
    {
      "src": "^/localized(?:/.*)?$",
      "status": 404,
      "dest": "/404.html"
    },
    {
      "src": "^/(?:(?:ar|zh)/)?(?:login|register|forgot-password|customer|dokhool|hesab-gadeed|esteeadet-kalemet-moroor|denglu|zhuce|zhaohui-mima)(?:/.*)?$",
      "status": 308,
      "headers": {
        "Location": "/"
      }
    },
    {
      "src": "^/(?:booking/confirmation|ar/takhteet-eqama/moayena|zh/zhusu-jihua/yulan)/?$",
      "status": 308,
      "headers": {
        "Location": "/booking/"
      }
    },
    {
      "src": "^/(.*/)?index\\.html$",
      "status": 301,
      "headers": {
        "Location": "/$1"
      }
    },
    {
      "src": "^/((?:[^./]+/)*[^./]+)$",
      "status": 308,
      "headers": {
        "Location": "/$1/"
      }
    },
    {
      "src": "^/assets/.*$",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable"
      },
      "continue": true
    },
    {
      "src": "^/fonts/.*$",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable"
      },
      "continue": true
    },
    {
      "src": "^/[^/]+\\.[0-9a-f]{12}\\.(?:js|css)$",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable"
      },
      "continue": true
    },
    {
      "src": "^/((?:[^./]+/)*)$",
      "headers": {
        "Cache-Control": "no-cache",
        "X-Content-Type-Options": "nosniff"
      },
      "continue": true
    },
    {
      "src": "^/sw\\.js$",
      "headers": {
        "Cache-Control": "no-cache"
      },
      "continue": true
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "^/.*$",
      "status": 404,
      "dest": "/404.html"
    }
  ],
  "proxy": {
    "entrypoint": "proxy.js"
  }
}
