# Template only. Supply production secrets on the host, never from the local clone.
APP_NAME="B&W Sahara Sky Hotel"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://bwsaharaskyhotel.com
APP_KEY=
CMS_ENABLE_INSTALLER=false
ENABLE_HTTP_SECURITY_HEADERS=true
LOG_CHANNEL=stack
DB_CONNECTION=mysql
DB_HOST=
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
DB_STRICT=true
SESSION_DRIVER=database
SESSION_HTTP_ONLY=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
CACHE_STORE=file
QUEUE_CONNECTION=database
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="B&W Sahara Sky Hotel"
TRACKING_MODE=off
GA4_MEASUREMENT_ID=
GTM_CONTAINER_ID=
# Refresh cookies are HttpOnly/Secure/SameSite=Strict in HotelTokenService.
# Run schedule:run each minute and process the security queue on the actual host.
